# lean-ctx self-deployment — 2nd fork-free deployment
# Copy to .env and set every empty value with a unique `openssl rand -hex 32` value.
# .env contains secrets; it must remain untracked.
POSTGRES_PASSWORD=
LEAN_CTX_PROXY_TOKEN=
LEAN_CTX_GATEWAY_ADMIN_TOKEN=
DATABASE_URL=postgres://leanctx:${POSTGRES_PASSWORD}@postgres:5432/leanctx
LEANCTX_IMAGE=ghcr.io/yvgude/lean-ctx-gateway:latest
